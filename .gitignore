
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Flatpack additions
.bin/
*.csproj.user
Benchmarks/*/local/
*.scene_d
Assets/flatpack/suite/
Assets/flatpack/gallery/
Assets/shaders/flatpack_impostor_v1.*
